# OPS-05: copy to `.env.production` on the host, fill in, and keep it out of
# version control. `scripts/check-env.mjs` refuses to start the application
# on any development value left behind here.

NODE_ENV=production

# Postgres service credentials (docker-compose.prod.yml).
POSTGRES_DB=kalloud
POSTGRES_USER=kalloud
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# What the application connects with. Must not point at localhost, must carry
# a password, and should force TLS unless the network is already encrypted
# end to end.
DATABASE_URL=postgresql://kalloud:CHANGEME@postgres:5432/kalloud

# Operator secret for GET /api/health/metrics (OPS-02). At least 32
# characters, unique per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_METRICS_TOKEN=
