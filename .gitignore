# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor/OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Local certificates (dev only, never real production certs)
certificates/*
!certificates/.gitkeep

# OPS-03: local backups. Dumps carry the whole database, password hashes and
# audit trail included — they never belong in version control.
/backups/
