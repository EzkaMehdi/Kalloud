# Copy this file to `.env` (never commit `.env`) and adjust as needed.
# `pnpm dev` reads it automatically (Next.js) and so do the standalone
# scripts under scripts/ (via `node --env-file=.env`).

# Main application database.
DATABASE_URL=postgresql://kalloud:kalloud_dev_password@localhost:5433/kalloud

# Used by `pnpm test:integration`. Kept separate from DATABASE_URL so
# integration tests can freely migrate/truncate it without ever touching
# local development data. The docker-compose Postgres service creates this
# database automatically on first start (database/init/01-create-test-database.sql).
DATABASE_URL_TEST=postgresql://kalloud:kalloud_dev_password@localhost:5433/kalloud_test

# OPS-02: shared secret for GET /api/health/metrics (operational metrics and
# alerts, across every establishment). Unset, the endpoint refuses rather
# than opening — a cross-tenant report must never fall back to "no auth
# configured, allow". Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_METRICS_TOKEN=dev_metrics_token_change_me
